# Runtime
APP_ENV=personal
PERSONAL_MODE=true
APP_BASE_URL=http://127.0.0.1:3000
API_BASE_URL=http://127.0.0.1:8000
APP_BIND_HOST=127.0.0.1
LOG_LEVEL=INFO

# AI provider: unconfigured | ollama | openai | anthropic
AI_PROVIDER=unconfigured
AI_MONTHLY_BUDGET_USD=10.00
AI_BUDGET_WARNING_PERCENT=80
AI_BUDGET_HARD_STOP=true
AI_MAX_REQUEST_COST_USD=1.00

# Ollama (optional; API charge recorded as zero)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma3

# OpenAI (required only when AI_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_STORE_RESPONSES=false

# Claude/Anthropic (required only when AI_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# v0.1 local data services
DATABASE_URL=postgresql+asyncpg://liproser:liproser@127.0.0.1:5432/liproser
PRIVATE_STORAGE_ROOT=./data/private

# LinkedIn integration: disabled until an approved official integration exists
LINKEDIN_INTEGRATION_ENABLED=false
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://127.0.0.1:8000/v1/integrations/linkedin/callback

# Personal bootstrap; replace with managed identity during productization
BOOTSTRAP_OWNER_EMAIL=
BOOTSTRAP_WORKSPACE_NAME=Personal Liproser
